# RBT — Riftbound Terminal configuration.
# Copy to .env and fill in. Everything is optional: with no keys at all the
# terminal runs its clearly-labeled SAMPLE market so you can drive the UI.

# ---- eBay (official Browse API — free) --------------------------------------
# 1. Create a free developer account at https://developer.ebay.com
# 2. Create an app under "Application Keys" (Production keyset)
# 3. Paste the App ID (Client ID) and Cert ID (Client Secret) here.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ---- X feed (pick one path) --------------------------------------------------
# twitterapi.io — pay-per-request (~$1-5/mo at our volume). Create a key at
# https://twitterapi.io and paste it here. If empty, RBT falls back to Nitter
# RSS (free, best-effort), and to SAMPLE items if that also fails.
TWITTERAPI_IO_KEY=
# Comma-separated Nitter instances to try, in order.
NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org
# Accounts for the WIRE panel (comma-separated, no @).
FEED_ACCOUNTS=riftcubtcg,smertcollector,riftvesting,riftboundgg

# ---- TCGplayer ---------------------------------------------------------------
# Daily catalog+prices come from TCGCSV (free, no key). Intraday top-ups hit
# TCGplayer's public price-points endpoint for watchlisted cards only,
# rate-limited to one request per 2.5s. Set to 0 to disable intraday entirely.
TCGPLAYER_INTRADAY=1
# Optional: pin the TCGplayer category id for Riftbound (autodiscovered if 0).
TCGPLAYER_CATEGORY_ID=0

# ---- Alert push notifications (optional, free) --------------------------------
# Fired price alerts can push to your phone via https://ntfy.sh:
# pick a long random topic string, put it here, and subscribe to the same
# topic in the ntfy mobile app. Empty = in-terminal alerts only.
NTFY_TOPIC=
# Self-hosted ntfy server if you run one; default is the public ntfy.sh.
NTFY_SERVER=https://ntfy.sh

# ---- Runtime -----------------------------------------------------------------
PORT=8787
# auto  = use real sources, fall back to SAMPLE if unreachable (default)
# live  = real sources only, never sample
# sample = simulated market only (demo)
RBT_MODE=auto
# Main refresh cycle in ms (60s default — keep >=30s to respect sources).
RBT_POLL_INTERVAL_MS=60000
# Identify honestly to the sites we touch.
RBT_USER_AGENT=riftbound-terminal/0.1 (personal price tracker)
