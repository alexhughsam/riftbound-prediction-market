{
  "name": "riftbound-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RBT \u2014 Riftbound Terminal. Cross-market price intelligence for Riftbound (Riot's TCG).",
  "scripts": {
    "dev": "concurrently -n srv,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite web",
    "build": "tsc -p server/tsconfig.json --noEmit && vite build web",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
